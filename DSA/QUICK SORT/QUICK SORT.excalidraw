    {
      "id": "7ObPfDVqCzadh7iEdYIOZ",
      "type": "text",
      "x": 747.3243431742783,
      "y": -311.74445307281627,
      "width": 542.7616370828226,
      "height": 121.07386551089411,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3jzS",
      "roundness": null,
      "seed": 607243973,
      "version": 1521,
      "versionNonce": 382408619,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1727209114924,
      "link": null,
      "locked": false,
      "text": "Well it's the idea of quick sort to\ntry to sort values less than the \npivot to the right and vice versa",
      "fontSize": 32.28636413623843,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Well it's the idea of quick sort to try to sort values less than the pivot to the right and vice versa",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "gvyCYQVnIbDAMwpbQ45CS",
      "type": "text",
      "x": -1056.0531787246664,
