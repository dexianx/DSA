      "roundness": null,
      "seed": 1980465253,
      "version": 857,
      "versionNonce": 1416932459,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1727208486706,
      "link": null,
      "locked": false,
      "text": "Partition \nFunction",
      "fontSize": 52.247858983559965,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Partition Function",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "7CYXsDW_j-f4n4hciQwI0",
      "type": "text",
      "x": -1814.9421099990805,
      "y": -1093.7177711261957,
      "width": 304.621822762118,
      "height": 130.61964745889992,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3jzd",
      "roundness": null,
      "seed": 62024965,
      "version": 895,
      "versionNonce": 536400197,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1727210224407,
      "link": null,
      "locked": false,
      "text": "Partition \nFunction",
      "fontSize": 52.247858983559965,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Partition Function",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "P0NqzJPRI3TxAJujO3x0U",
      "type": "text",
      "x": -1484.7544555019822,
      "y": 111.30891043345616,
      "width": 1118.654967901103,
      "height": 533.6694531100576,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3jzl",
      "roundness": null,
      "seed": 1873767115,
      "version": 1328,
      "versionNonce": 218085,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1727209311223,
      "link": null,
      "locked": false,
      "text": "def partition(array, start, end):\n    i = start -1 \n    pivot = array[end]\n    for(j in array):\n        if(array[j] < pivot ):\n            i+=1\n            //swap the element at i's new position\n            array[i], array[j] = array[j], array[i]\n            ",
      "fontSize": 47.437284720894006,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def partition(array, start, end):\n    i = start -1 \n    pivot = array[end]\n    for(j in array):\n        if(array[j] < pivot ):\n            i+=1\n            //swap the element at i's new position\n            array[i], array[j] = array[j], array[i]\n            ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Zi2JAW7c7U6Vm1NZS7NAq",
      "type": "text",
      "x": -1398.4837657398296,
      "y": 621.1240811949812,
      "width": 1000.5944758270175,
      "height": 106.07713370508223,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3jzt",
      "roundness": null,
      "seed": 1462049963,
      "version": 1704,
      "versionNonce": 1318952677,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1727210021811,
      "link": null,
      "locked": false,
      "text": "//After it's done with the iteration, we then \nswap the pivot element ahead of i ",
      "fontSize": 42.4308534820329,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "//After it's done with the iteration, we then swap the pivot element ahead of i ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "kw5dL3AsOEWrXWoo-Cmhi",
      "type": "text",
      "x": -1388.3625368409685,
      "y": 830.1915999357237,
      "width": 879.071642825973,
      "height": 139.79099791949778,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3jztV",
      "roundness": null,
      "seed": 154469323,
      "version": 2020,
      "versionNonce": 1176904773,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1727210018277,
      "link": null,
      "locked": false,
      "text": "//Then we return the final value of the current \nposition of the pivot, so we can pass it to the \nrecursive function",
      "fontSize": 37.27759944519941,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "//Then we return the final value of the current position of the pivot, so we can pass it to the recursive function",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "vU-QiUnoL9Vx16ErejQw9",
      "type": "text",
      "x": -1387.6215629601218,
      "y": 749.514773682491,
      "width": 1000.5944758270175,
      "height": 53.03856685254112,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3jzu",
      "roundness": null,
      "seed": 2087998379,
      "version": 1800,
      "versionNonce": 1664350565,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1727210020178,
      "link": null,
      "locked": false,
      "text": "array[i+1], array[end] = array[end], array[i+1]",
      "fontSize": 42.4308534820329,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "array[i+1], array[end] = array[end], array[i+1]",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "pHgcNH5HXkZsu0QV-r8S_",
      "type": "text",
      "x": -1394.573919327415,
      "y": 988.2489846385573,
      "width": 1000.5944758270175,
      "height": 53.03856685254112,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3jzuV",
      "roundness": null,
      "seed": 1760194347,
      "version": 1908,
      "versionNonce": 1490451941,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1727210016646,
      "link": null,
      "locked": false,
      "text": "return i + 1",
      "fontSize": 42.4308534820329,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "return i + 1",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "mLcaD3Zd8E_KzCsCfHsGD",
      "type": "text",
      "x": -2282.620244192093,
      "y": 712.5263988826335,
      "width": 795.2469521599434,
      "height": 168.61479712469077,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3jzv",
      "roundness": null,
      "seed": 1534523627,
      "version": 2002,
      "versionNonce": 855673317,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1727209666339,
      "link": null,
      "locked": false,
      "text": "Because after the Iteration, the ith element\nis the last smaller element before the pivot so \nwe want the pivot to be after the element \nlesser (the pivot is at the end position)",
      "fontSize": 33.722959424938146,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Because after the Iteration, the ith element\nis the last smaller element before the pivot so we want the pivot to be after the element lesser (the pivot is at the end position)",
      "autoResize": false,
      "lineHeight": 1.25
    },
